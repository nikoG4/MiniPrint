{
  "MiniPrint": {
    "Port": 631,
    "AdvertisedHost": null,
    "DataDirectory": "%ProgramData%\\MiniPrint",
    "MaxRequestBytes": 104857600,
    "EnableMdns": true,
    "AllowPrivateNetworksOnly": true,
    "IncludeVirtualPrinters": false,
    "EnableRawPrinting": false,
    "KeepPayloadsAfterPrinting": false,
    "MaxHistoryJobs": 500,
    "Language": "es"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
